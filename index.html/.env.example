# Copy this file to .env and fill in real values. Never commit the real .env file.

# Your MongoDB Atlas connection string (from Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/rubashree?retryWrites=true&w=majority

# Any long random string - used to sign login sessions
JWT_SECRET=replace-this-with-a-long-random-string

# Port the server listens on locally (Render sets this automatically in production)
PORT=5000
